pipeline {
    agent any
    
    tools {
        nodejs 'NodeJS-18'
    }
    
    environment {
        CI = 'true'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install System Dependencies') {
            steps {
                sh '''
                    apt-get update || true
                    apt-get install -y libglib2.0-0 libnss3 libatk-bridge2.0-0 libdrm-dev libxkbcommon-dev libgbm-dev libasound-dev libxshmfence-dev libxrandr2 libx11-6 libxcomposite1 libxdamage1 libxext6 libxfixes3 libatk1.0-0 libcups2 libdbus-1-3 libxcb1 libxkbcommon0 || true
                '''
            }
        }
        
        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
                sh 'npx playwright install chromium || true'
            }
        }
        
        stage('Run Tests') {
            steps {
                sh 'npx playwright test --reporter=junit,html || true'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'playwright-report/**', allowEmptyArchive: true
                     archiveArtifacts artifacts: 'test-results/**', allowEmptyArchive: true
                    // Измените путь здесь:
                    junit testResults: '**/junit.xml', allowEmptyResults: true  // ← ищет любой junit.xml
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
    }
}