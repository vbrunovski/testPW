pipeline {
    agent any
    
    tools {
        nodejs 'NodeJS-18'
    }
    
    environment {
        CI = 'true'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
                // Устанавливаем браузер, игнорируя предупреждения о системных зависимостях
                sh 'npx playwright install chromium || true'
            }
        }
        
        stage('Run Tests') {
            steps {
                // Запускаем тесты, игнорируя ошибки (продолжаем даже если что-то не так)
                sh '''
                    npx playwright test --reporter=junit,html || true
                '''
            }
            post {
                always {
                    // Архивация отчетов и результатов
                    archiveArtifacts artifacts: 'playwright-report/**', allowEmptyArchive: true
                    archiveArtifacts artifacts: 'test-results/**', allowEmptyArchive: true
                    
                    // Публикация JUnit отчета
                    junit testResults: 'test-results/junit.xml', allowEmptyResults: true
                }
            }
        }
    }
    
    post {
        always {
            // Очистка рабочей директории
            cleanWs()
        }
    }
}