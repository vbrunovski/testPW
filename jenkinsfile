pipeline {
    agent any
    
    tools {
        nodejs 'NodeJS-18'
    }
    
    environment {
        CI = 'true'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
                sh 'npx playwright install chromium || true'
            }
        }
        
        stage('Debug - Check Files') {
            steps {
                sh '''
                    echo "=== Current directory ==="
                    pwd
                    echo "=== List all files ==="
                    ls -la
                    echo "=== Check tests directory ==="
                    ls -la tests/ || echo "No tests directory"
                    echo "=== Check for spec files ==="
                    find . -name "*.spec.js" -type f
                    echo "=== Check playwright config ==="
                    cat playwright.config.js | grep testDir
                '''
            }
        }
        
        stage('Run Tests') {
            steps {
                sh '''
                    npx playwright test --reporter=junit,html --debug || true
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'playwright-report/**', allowEmptyArchive: true
                    archiveArtifacts artifacts: 'test-results/**', allowEmptyArchive: true
                    junit testResults: 'test-results/junit.xml', allowEmptyResults: true
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
    }
}