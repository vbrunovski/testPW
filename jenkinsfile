pipeline {
    agent any

    tools {
        nodejs 'NodeJS-18'   // ← это имя должно СОВПАДАТЬ с тем, что вы указали в Global Tool Configuration
    }
    
    environment {
        CI = 'true'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
                sh 'npx playwright install --with-deps chromium'
            }
        }
        
        stage('Run Tests') {
            steps {
                sh 'npm run test:ci'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'playwright-report/**', allowEmptyArchive: true
                    archiveArtifacts artifacts: 'test-results/**', allowEmptyArchive: true
                    junit 'test-results/junit.xml'
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
    }
}